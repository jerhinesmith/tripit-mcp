# Preferred setup: run `tripit-mcp login` once. It opens a real Chrome
# window for you to sign in through, then saves your session to
# session.json — no secrets needed here, and your password is never
# written to disk (or even received by this program at all).

# Optional: data dir for session.json (default: ~/.tripit-mcp)
# TRIPIT_DATA_DIR=

# Optional bootstrap: seed session.json from a manually-captured `Cookie`
# header string instead of running `login`. Used once, then session.json
# is authoritative.
# TRIPIT_SESSION_COOKIE=

# Optional: dev proxy (e.g. Proxyman) http://localhost:9090
# TRIPIT_PROXY_URL=
